# 数据库配置
# 开发阶段（SQLite）
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# 生产阶段（MySQL）
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/agent_os?charset=utf8mb4

# 安全配置
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
LLM_ENCRYPTION_KEY=your-aes-256-key-32-bytes-base64-encoded-here

# 服务配置
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis 配置（运行时热加载必需）
REDIS_IS_CLUSTER=false
REDIS_ADDRESS=localhost:6379
REDIS_DB=0
REDIS_STREAM_KEY=agent:publish

# 运行时 Agent 池配置
RUNTIME_AGENT_LOAD_MODE=eager
RUNTIME_AGENT_POOL_MAX_SIZE=100
